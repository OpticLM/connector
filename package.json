{
  "name": "@opticlm/connector",
  "version": "2.10.2",
  "description": "Provides an abstract interface that allows LLMs to connect to fact sources such as LSPs, code diagnostics, symbol definitions/references, links, and frontmatter",
  "type": "module",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./lsp": {
      "types": "./dist/lsp/index.d.mts",
      "default": "./dist/lsp/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.mts",
      "default": "./dist/mcp/index.mjs"
    },
    "./pipe": {
      "types": "./dist/pipe/index.d.mts",
      "default": "./dist/pipe/index.mjs"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.mts",
      "default": "./dist/ai-sdk/index.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "default": "./dist/schemas.mjs"
    }
  },
  "files": ["dist/**/*.mjs", "dist/**/*.d.mts", "LICENSE"],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["mcp", "lsp", "language-server", "ide", "vscode", "jetbrains"],
  "author": "EFLKumo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpticLM/connector"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.146",
    "vscode-languageserver-protocol": "^3.17.5",
    "zod": "^4.0"
  },
  "peerDependenciesMeta": {
    "vscode-languageserver-protocol": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/node": "^25",
    "nanoid": "^5.1.7",
    "tsdown": "^0.21.10",
    "typescript": "^6",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
